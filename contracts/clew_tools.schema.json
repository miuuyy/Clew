      },
      {
        "type": "function",
        "name": "ask_question",
        "description": "Ask the user a focused question, optionally with choices. Waits for their answer; free-text replies are always allowed.",
        "inputSchema": {
          "additionalProperties": false,
          "properties": {
            "question": {
              "maxLength": 4000,
              "minLength": 1,
              "title": "Question",
              "type": "string"
            },
            "choices": {
              "items": {
                "type": "string"
              },
              "maxItems": 6,
              "title": "Choices",
              "type": "array"
            }
          },
          "required": [
            "question"
          ],
          "title": "QuestionDraft",
          "type": "object"
        }
      },
      {
        "type": "function",
        "name": "present_quiz",
        "description": "Present one multiple-choice learning checkpoint with exactly four distinct choices. Waits for the user's answer and returns the graded result. Does not award topic completion.",
        "inputSchema": {
          "additionalProperties": false,
          "properties": {
            "question": {
              "minLength": 1,
              "title": "Question",
              "type": "string"
            },
            "choices": {
              "items": {
                "type": "string"
              },
              "title": "Choices",
              "type": "array"
            },
            "correct_index": {
              "title": "Correct Index",
              "type": "integer"
            }
          },
          "required": [
            "question",
            "choices",
            "correct_index"
          ],
          "title": "InlineQuizDraft",
          "type": "object"
        }
      },
      {
        "type": "function",
        "name": "create_closure_quiz",
        "description": "Register a complete closure quiz for a topic. Supply the requested number of questions with four distinct choices each. Clew checks prerequisites and grades the learner's answers itself.",
        "inputSchema": {
          "$defs": {
            "QuizQuestionDraft": {
              "additionalProperties": false,
              "properties": {
                "prompt": {
                  "minLength": 1,
                  "title": "Prompt",
                  "type": "string"
                },
                "choices": {
                  "items": {
                    "type": "string"
                  },
                  "title": "Choices",
                  "type": "array"
                },
                "correct_choice_index": {
                  "title": "Correct Choice Index",
                  "type": "integer"
                },
                "explanation": {
                  "default": "",
                  "title": "Explanation",
                  "type": "string"
                }
              },
              "required": [
                "prompt",
                "choices",
                "correct_choice_index"
              ],
              "title": "QuizQuestionDraft",
              "type": "object"
            }
          },
          "additionalProperties": false,
          "properties": {
            "questions": {
              "items": {
                "$ref": "#/$defs/QuizQuestionDraft"
              },
              "title": "Questions",
              "type": "array"
            },
            "topic_id": {
              "title": "Topic Id",
              "type": "string"
            }
          },
          "required": [
            "topic_id"
          ],
          "title": "ClosureQuizDraft",
          "type": "object"
        }
      },
      {
        "type": "function",
        "name": "read_graph",
        "description": "Read the current graph, its version, topics, edges, zones and progress. Call again after a conflict; do not guess ids or graph revisions.",
        "inputSchema": {
          "type": "object",
          "properties": {},
          "additionalProperties": false
        }
      },
      {
        "type": "function",
        "name": "read_topic",
        "description": "Read the full content, resources, artifacts and prerequisites of a topic in this conversation's graph.",
        "inputSchema": {
          "type": "object",
          "properties": {
            "topic_id": {
              "type": "string"
            }
          },
          "required": [
            "topic_id"
          ],
          "additionalProperties": false
        }
      }
    ]
  }
