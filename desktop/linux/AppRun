#!/bin/sh
set -eu

app_dir="${APPDIR:-$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)}"
for argument in "$@"; do
  case "$argument" in
    --no-sandbox|--disable-setuid-sandbox|--disable-gpu-sandbox)
      echo "Clew requires the Chromium sandbox." >&2
      exit 1
      ;;
  esac
done
# Read-only AppImages cannot install a root-owned setuid helper. Require user
# namespaces; the Debian installer supports distributions that restrict them.
if ! unshare -Ur true 2>/dev/null; then
  echo "Clew AppImage requires unprivileged user namespaces. Install the Debian package on distributions that restrict them." >&2
  exit 1
fi
export LD_LIBRARY_PATH="$app_dir/usr/lib${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
exec "$app_dir/clew" "$@"
