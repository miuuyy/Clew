# Clew uses the installed Codex CLI. Sign in with ChatGPT in Settings → Codex.
# Provider API keys are not used. All overrides below are optional.

# KG_CODEX_BINARY=/absolute/path/to/codex
# KG_CODEX_HOME=/absolute/path/to/a/dedicated/clew-codex-home
# KG_CODEX_WORKSPACE=/absolute/path/to/a/dedicated/clew-agent-workspace
# KG_CODEX_RPC_TIMEOUT_SECONDS=30
# KG_DB_PATH=/absolute/path/to/knowledge_graph.sqlite3
# KG_FRONTEND_ORIGIN=http://127.0.0.1:5178
